#!/bin/sh
# Exécute le même calcul en série (1x1) puis en parallèle (dim_x x dim_y) et affiche l'accélération.
#
# Usage: scripts/run-all <heatsim> <image> <itérations> <dim_x> <dim_y> [dossier-de-sortie]

set -e

heatsim="$1" image="$2" iterations="$3" dim_x="$4" dim_y="$5" out="${6:-.}"
ranks=$((dim_x * dim_y))

if mpirun --oversubscribe --help >/dev/null 2>&1; then
    mpi="mpirun --oversubscribe"
else
    mpi="mpirun"
fi

mkdir -p "$out"

# Secondes écoulées d'une commande, sur la dernière ligne de stdout.
timed() {
    perl -MTime::HiRes=time -e '
        my $t = time;
        system(@ARGV) == 0 or exit 1;
        printf "%.2f\n", time - $t;
    ' -- "$@" | tail -n 1
}

echo "Série (1x1)..."
serial=$(timed $mpi -n 1 "$heatsim" --dim-x 1 --dim-y 1 --input "$image" --iterations "$iterations" --output "$out/serial.png")

echo "Parallèle (${dim_x}x${dim_y}, $ranks rangs)..."
parallel=$(timed $mpi -n "$ranks" "$heatsim" --dim-x "$dim_x" --dim-y "$dim_y" --input "$image" --iterations "$iterations" --output "$out/parallel.png")

echo
echo "série:      ${serial} s"
echo "parallèle:  ${parallel} s"
awk -v s="$serial" -v p="$parallel" 'BEGIN { printf "accélération: x%.2f\n", s / p }'
