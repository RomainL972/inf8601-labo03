#!/bin/sh
# Vérifie le résultat pour plusieurs topologies (1x1, 1x5, 3x3, 2x5, 4x4 et 8x4): le SHA-256 de chaque
# image produite doit être celui de images/check<N>.checksum. La 1x5 (un rang est son propre voisin
# en X, anneau impair en Y) et la 3x3 (anneaux impairs) sont celles qui font bloquer un échange de
# bordures mal ordonné.
#
# Usage: scripts/run-check <heatsim> [dossier-de-sortie]

set -e

heatsim="$1"
out="${2:-.}"
cd "$(dirname "$0")/.."

if mpirun --oversubscribe --help >/dev/null 2>&1; then
    mpi="mpirun --oversubscribe"
else
    mpi="mpirun"
fi

if command -v sha256sum >/dev/null 2>&1; then
    sha256() { sha256sum "$1" | cut -d' ' -f1; }
else
    sha256() { shasum -a 256 "$1" | cut -d' ' -f1; }
fi

mkdir -p "$out"
failed=0

check() {
    n="$1" dim_x="$2" dim_y="$3"
    echo "Running check N=$n: ${dim_x}x${dim_y}"
    $mpi -n "$n" "$heatsim" --dim-x "$dim_x" --dim-y "$dim_y" \
        --input ./images/earth-medium.png --iterations 10 --output "$out/check$n.png" >/dev/null

    expected=$(cut -d' ' -f1 "images/check$n.checksum")
    actual=$(sha256 "$out/check$n.png")
    if [ "$expected" = "$actual" ]; then
        echo "check$n.png: OK"
    else
        echo "check$n.png: FAILED"
        failed=1
    fi
}

check 1 1 1
check 5 1 5
check 9 3 3
check 10 2 5
check 16 4 4
check 32 8 4

exit $failed
